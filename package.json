{
  "name": "mcp-oauth-starter",
  "version": "0.1.0",
  "description": "A remote MCP server protected by a spec-compliant OAuth 2.1 authorization server, in one small TypeScript codebase.",
  "type": "module",
  "license": "MIT",
  "author": "Kauã Araujo de Souza",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "oauth2.1",
    "pkce",
    "hono",
    "typescript"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}

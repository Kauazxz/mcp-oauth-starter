# Copy to .env and adjust. Never commit the real .env.

# Port the HTTP server listens on.
PORT=3000

# Public origin of this server (no path). It is the OAuth issuer, and the MCP endpoint
# becomes ${ISSUER_URL}/mcp. Must be https unless it is localhost.
# Defaults to http://localhost:${PORT}.
# ISSUER_URL=https://mcp.example.com

# The single demo user shown on the login page. Replace with your own identity provider.
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me-please

# Token lifetimes in seconds.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=60

# Requests per minute per IP on /register, /token and the login form.
RATE_LIMIT_PER_MINUTE=30

# Set to true only behind a reverse proxy you control, so X-Forwarded-For is trusted.
TRUST_PROXY=false
